{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "racik-image-tools",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "image.solusikoding.com", "custom_domain": true }]
}
